# 应用配置
APP_ENV=development
APP_DEBUG=true

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=slimcms
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_TABLEPRE=cs_
DB_CONNECTTYPE=;port=
DB_PCONNECT=0

# Redis配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_PREFIX=
REDIS_PCONNECT=0
REDIS_TIMEOUT=0
REDIS_SERIALIZER=1

# 缓存配置
CACHE_TYPE=file

# Session配置
SESSION_DOMAIN=
SESSION_LIFETIME=0

# Cookie配置
COOKIE_PREFIX=slimcms_
COOKIE_DOMAIN=
COOKIE_PATH=/

# 上传配置
UPLOAD_DIR=/uploads/
UPLOAD_DIR_RULE={Y}/{m}
UPLOAD_FORBID_FILE=php|pl|cgi|asp|aspx|jsp|php3|shtm|shtml|js
UPLOAD_CHECK_WORDS=

# 安全配置
AUTH_KEY=
ENCRYPT_KEY=
ENCRYPT_IV=
ATTACK_EVASIVE=0

# 输出配置
OUTPUT_GZIP=0

# 内存缓存前缀
MEMORY_PREFIX=slimcms_
